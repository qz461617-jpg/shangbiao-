    def calibrate_coords_to_resolution(self, w, h):
        """按底图尺寸把参考图量得的基准坐标换算到实际像素。"""
        sx = w / 1280.0
        sy = h / 1810.0

        def set_entry(entry_w, val):
            entry_w.delete(0, tk.END)
            entry_w.insert(0, str(int(round(val))))

        set_entry(self.e_reg_x, 932 * sx)
        set_entry(self.e_reg_y, 187 * sy)
        set_entry(self.e_reg_size, max(12, 37 * sy))

        set_entry(self.e_tmzc_x, 146 * sx)
        set_entry(self.e_tmzc_y, 226 * sy)
        set_entry(self.e_tmzc_size, max(10, 17 * sy))

        set_entry(self.e_num1_x, 636 * sx)
        set_entry(self.e_num1_y, 666 * sy)
        set_entry(self.e_num1_size, max(18, 70 * sy))

        set_entry(self.e_comp_x, 276 * sx)
        set_entry(self.e_comp_y, 1106 * sy)
        set_entry(self.e_comp_size, max(12, 29 * sy))

        set_entry(self.e_addr_x, 276 * sx)
        set_entry(self.e_addr_y, 1252 * sy)
        set_entry(self.e_addr_size, max(12, 28 * sy))

        set_entry(self.e_cat_hx, 92 * sx)
        set_entry(self.e_cat_hy, 913 * sy)
        set_entry(self.e_cat_bx, 94 * sx)
        set_entry(self.e_cat_by, 968 * sy)
        set_entry(self.e_cat_bsize, max(11, 27 * sy))

        set_entry(self.e_rdate_x, 276 * sx)
        set_entry(self.e_rdate_y, 1433 * sy)
        set_entry(self.e_edate_x, 676 * sx)
        set_entry(self.e_edate_y, 1433 * sy)

        self.settings["cat_head_size"] = str(32)
        self.settings["cat_wrap_width"] = str(1050)
        self.settings["addr_wrap_width"] = str(860)
        self.settings["date_size"] = str(27)
        self.settings["qr_x"] = str(92)
        self.settings["qr_y"] = str(1542)
        self.settings["qr_size"] = str(146)
        self.settings["seal_x"] = str(895)
        self.settings["seal_y"] = str(1389)
        self.settings["seal_size"] = str(281)
        self.settings["emblem_x"] = str(634)
        self.settings["emblem_y"] = str(172)
        self.settings["emblem_w"] = str(248)
        self.settings["emblem_h"] = str(262)
        self.settings["emblem_h"] = str(int(round(268 * sy)))

