    def refresh_right_preview(self):
        try:
            img = self.render_sample_image(show_red_dots=self.var_show_dots.get(), draw_texts=True)
            self.preview_orig_w, self.preview_orig_h = img.size

            disp_w = max(1, int(round(self.preview_orig_w * self.preview_scale)))
            disp_h = max(1, int(round(self.preview_orig_h * self.preview_scale)))

            self.preview_offset_x = 12
            self.preview_offset_y = 12

            img_disp = img.resize((disp_w, disp_h), Image.Resampling.LANCZOS)
            self.preview_tk_img = ImageTk.PhotoImage(img_disp)

            self.preview_canvas.delete("all")
            self.preview_canvas.config(scrollregion=(0, 0, disp_w + 24, disp_h + 24))
            self.preview_canvas.create_image(
                self.preview_offset_x, self.preview_offset_y,
                anchor="nw", image=self.preview_tk_img
            )
        except Exception:
            pass

    def on_right_preview_click(self, event):
        cx = self.preview_canvas.canvasx(event.x)
        cy = self.preview_canvas.canvasy(event.y)
        rx = int(round((cx - self.preview_offset_x) / self.preview_scale))
        ry = int(round((cy - self.preview_offset_y) / self.preview_scale))
        rx = max(0, min(self.preview_orig_w, rx))
        ry = max(0, min(self.preview_orig_h, ry))
        self.lbl_right_coord.config(text=f"X={rx}, Y={ry}")

        fmap = self.get_picker_field_map()
        name_to_key = {v[0]: k for k, v in fmap.items()}
        target_name = self.combo_right_target.get()
        t_key = name_to_key.get(target_name, "none")
        _, entry_x, entry_y = fmap.get(t_key, ("", None, None))

        if entry_x is not None and entry_y is not None:
            entry_x.delete(0, tk.END)
            entry_x.insert(0, str(rx))
            entry_y.delete(0, tk.END)
            entry_y.insert(0, str(ry))
            self.save_config()
            self.refresh_right_preview()
            self.append_log(f"已更新【{target_name}】坐标为: X={rx}, Y={ry}")

    def select_template_image(self, parent_win=None):
        p_win = parent_win if parent_win else self.root
        file_path = filedialog.askopenfilename(
            parent=p_win,
            title="请选择商标注册证底图图片 (如第3张图，支持 PNG / JPG / BMP)",
            filetypes=[("图片文件", "*.png;*.jpg;*.jpeg;*.bmp"), ("所有文件", "*.*")]
        )
        if not file_path:
            return False
        abs_path = os.path.abspath(file_path)
        self.e_tpl_path.delete(0, tk.END)
        self.e_tpl_path.insert(0, abs_path)
        try:
            with Image.open(abs_path) as im:
                w, h = im.size
            self.calibrate_coords_to_resolution(w, h)
            self.append_log(f"已切换底图({w}x{h})并自动按图3比例对齐全部坐标：{abs_path}")
        except Exception:
            self.append_log(f"已切换底图：{abs_path}")
        self.save_config()
        self.refresh_right_preview()
        return True

    def get_valid_template_path(self, parent_win=None, auto_create_demo=False):
        cur_path = self.e_tpl_path.get().strip()
        if cur_path and os.path.exists(cur_path) and os.path.basename(cur_path) != "template.png":
            return cur_path

        for cand in ["image_6d6814.png", "image_6de031.png", DEFAULT_TEMPLATE_PATH]:
            if os.path.exists(cand):
                abs_def = os.path.abspath(cand)
                self.e_tpl_path.delete(0, tk.END)
                self.e_tpl_path.insert(0, abs_def)
                return abs_def

        if not auto_create_demo:
            p_win = parent_win if parent_win else self.root
            if messagebox.askyesno(
                "请选择底图图片",
                "当前尚未设置底图，或原底图文件已被移动。\n\n是否立即从电脑中选择一张底图图片？",
                parent=p_win
            ):
                if self.select_template_image(parent_win=p_win):
                    return self.e_tpl_path.get().strip()

        demo_img = build_certificate_base_image(
            1280, 1810, self.settings.get("director_name", "申长雨")
        )
        demo_img.save(DEFAULT_TEMPLATE_PATH)
        abs_demo = os.path.abspath(DEFAULT_TEMPLATE_PATH)
        self.e_tpl_path.delete(0, tk.END)
        self.e_tpl_path.insert(0, abs_demo)
        return abs_demo

