                pyautogui.press("tab")
                time.sleep(0.2)
                paste_text_clean(op_idcard)
                pyautogui.press("tab")
                time.sleep(0.2)
                paste_text_clean(op_phone)
                if trigger_sms:
                    time.sleep(0.35)
                    pyautogui.click(int(self.e_code_btn_x.get()), int(self.e_code_btn_y.get()))

            if trigger_sms:
                self.lbl_copy_status.config(text=f"✅ 已填入运营人【{op_name}】，软件正在读取短信……", fg="#059669")
                route_state["status"].config(text="读取中", bg="#17A2B8", fg="white")
