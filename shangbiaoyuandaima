SMS_NEXT_HOST_SUFFIX = "szfangmm.com"

SMS_OTP_PATTERN = re.compile(r"(?:验证码\s*[:：]?\s*|code\D{0,20})(\d{4})(?!\d)", re.IGNORECASE)

