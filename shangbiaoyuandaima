    def load_font_by_name(self, font_name, size):
        fpath = FONT_MAP.get(font_name, FONT_COMPANY)
        try:
            return ImageFont.truetype(fpath, max(8, int(size)))
        except Exception:
            try:
                return ImageFont.truetype(FONT_COMPANY, max(8, int(size)))
            except Exception:
                return ImageFont.load_default()

    def erase_region_if_needed(self, img, draw, x, y, erase_w, erase_h, center_x=False):
        if not self.var_auto_erase.get():
            return
        rx = int(x - erase_w / 2) if center_x else x
        ry = y
        bg_col = sample_bg_color(img, rx, ry)
        draw.rectangle([(rx - 2, ry - 2), (rx + erase_w, ry + erase_h)], fill=bg_col)

    def draw_single_text(self, img, draw, text, x, y, size, font_name, color=(35, 35, 35),
                         center_x=False, show_dot=False, erase_w=0, erase_h=0):
        if not text:
            return
        font_obj = self.load_font_by_name(font_name, size)
        try:
            bbox = draw.textbbox((0, 0), text, font=font_obj)
            text_w = bbox[2] - bbox[0]
            text_h = bbox[3] - bbox[1]
        except Exception:
            text_w, text_h = len(text) * size, size + 6

        if erase_w > 0 and erase_h > 0:
            self.erase_region_if_needed(img, draw, x, y, max(erase_w, text_w + 6), max(erase_h, text_h + 6), center_x=center_x)

        draw_x = int(x - text_w / 2) if center_x else x
        draw.text((draw_x, y), text, font=font_obj, fill=color)
        if show_dot:
            draw.ellipse([(x - 5, y - 5), (x + 5, y + 5)], fill=(220, 38, 38), outline=(255, 255, 255))

    def draw_wrapped_address_block(self, img, draw, address, ax, ay, asize, afont_name, show_dot=False):
        """地址按可用宽度折行，行距随字号收紧，字色对齐证书原色。"""
        if not address:
            return
        sx = img.width / 1280.0
        sy = img.height / 1810.0
        afont = self.load_font_by_name(afont_name, asize)
        addr_max_w = max(40, int(float(self.settings.get("addr_wrap_width", 860)) * sx))

        addr_lines = []
        cur_a = ""
        for ch in address:
            test_a = cur_a + ch
            if draw.textlength(test_a, font=afont) > addr_max_w and cur_a:
                addr_lines.append(cur_a)
                cur_a = ch
            else:
                cur_a = test_a
        if cur_a:
            addr_lines.append(cur_a)

        a_line_h = int(round(asize * 1.16))
        self.erase_region_if_needed(img, draw, ax, ay, addr_max_w + 16,
                                    max(int(92 * sy), len(addr_lines) * a_line_h + 10))
        for idx, aln in enumerate(addr_lines):
            draw.text((ax, ay + idx * a_line_h), aln, font=afont, fill=CERT_INK)

        if show_dot:
            draw.ellipse([(ax - 5, ay - 5), (ax + 5, ay + 5)], fill=(220, 38, 38), outline=(255, 255, 255))

    def draw_wrapped_category_block(self, img, draw, cat_no, items_str, hx, hy, hsize, bx, by, bsize, show_dot=False):
        """核定使用商品/服务项目：标题单行 + 首行带“第X类：”前缀的自动折行正文。"""
        sx = img.width / 1280.0
        sy = img.height / 1810.0
        head_text = f"核定使用商品/服务项目（国际分类：{cat_no}）"
        head_font = self.load_font_by_name("宋体", hsize)
        self.erase_region_if_needed(img, draw, hx, hy, int(760 * sx), hsize + 16)
        draw_tracked_text(draw, hx, hy, head_text, head_font, (12, 12, 12), tracking=0)

        body_content = (items_str or "").strip()
        if body_content and not body_content.endswith(" ") and not body_content.endswith("（截止）"):
            body_content += "（截止）"

        prefix_str = f"第{cat_no}类：  "
        font_prefix = self.load_font_by_name("宋体", bsize)
        font_body = self.load_font_by_name("宋体", bsize)
        prefix_w = draw.textlength(prefix_str, font=font_prefix)
        max_w = max(60, int(float(self.settings.get("cat_wrap_width", 1050)) * sx))

        lines, cur_line = [], ""
        for ch in body_content:
            test_line = cur_line + ch
            limit_w = max_w - prefix_w if not lines else max_w
            if draw.textlength(test_line, font=font_body) > limit_w and cur_line:
                lines.append(cur_line)
                cur_line = ch
            else:
                cur_line = test_line
        if cur_line:
            lines.append(cur_line)

        line_h = int(round(bsize * 1.30))
        total_h = max(int(96 * sy), len(lines) * line_h + 14)
        self.erase_region_if_needed(img, draw, bx, by, max_w + 16, total_h)

        draw.text((bx, by), prefix_str, font=font_prefix, fill=CERT_INK)
        if lines:
            draw.text((bx + prefix_w, by), lines[0], font=font_body, fill=CERT_INK)
            for idx in range(1, len(lines)):
                draw.text((bx, by + idx * line_h), lines[idx], font=font_body, fill=CERT_INK)

        if show_dot:
            draw.ellipse([(bx - 5, by - 5), (bx + 5, by + 5)], fill=(220, 38, 38), outline=(255, 255, 255))

    def render_certificate_elements(self, img, company_name, soft_name, reg_no, tmzc_code, address, show_red_dots=False):
        """把证书动态信息叠到底图上：国徽、条码、名称、分类、注册人、地址、日期、二维码、机关章。"""
        draw = ImageDraw.Draw(img)
        sx = img.width / 1280.0
        sy = img.height / 1810.0

        def setting_num(key, default):
            try:
                return float(self.settings.get(key, default))
            except (TypeError, ValueError):
                return float(default)

        def entry_num(entry, default):
            try:
                return int(round(float(entry.get())))
            except (TypeError, ValueError):
                return int(default)

        def dot(x, y):
            if show_red_dots:
                draw.ellipse([(x - 5, y - 5), (x + 5, y + 5)], fill=(220, 38, 38), outline=(255, 255, 255))

        # ① 国徽
        em_mode = self.var_emblem_mode.get()
        if em_mode in ("emblem1", "emblem2"):
            try:
                em_w = max(40, int(round(setting_num("emblem_w", 248) * sx)))
                em_h = max(40, int(round(setting_num("emblem_h", 262) * sy)))
                em_cx = int(round(setting_num("emblem_x", 634) * sx))
                em_top = int(round(setting_num("emblem_y", 172) * sy))
                custom_em = self.settings.get("custom_emblem_path", "")
                if custom_em and os.path.exists(custom_em):
                    emblem_layer = extract_emblem_rgba(custom_em, em_w, em_h, style=em_mode)
                else:
                    emblem_layer = build_procedural_emblem_rgba(em_w, em_h, style=em_mode)
                self.erase_region_if_needed(img, draw, em_cx - em_w // 2, em_top, em_w + 10, em_h + 6)
                img.paste(emblem_layer, (em_cx - em_w // 2, em_top), emblem_layer)
                dot(em_cx, em_top)
            except Exception:
                pass

        # ② 右上角注册号
        if self.var_reg.get() and reg_no:
            try:
                self.draw_single_text(
                    img, draw, reg_no,
                    entry_num(self.e_reg_x, 932), entry_num(self.e_reg_y, 187),
                    max(8, entry_num(self.e_reg_size, 37)),
                    self.combo_reg_font.get() or "宋体", (12, 12, 12),
                    show_dot=show_red_dots,
                    erase_w=int(172 * sx), erase_h=int(48 * sy)
                )
            except Exception:
                pass

        # ③ 左上角条码与条码号
        if self.var_tmzc.get() and tmzc_code:
            try:
                bar_x = int(round(103 * sx))
                bar_y = int(round(188 * sy))
                bar_w = int(round(303 * sx))
                bar_h = int(round(40 * sy))
                self.erase_region_if_needed(img, draw, bar_x, bar_y, bar_w + 10, bar_h + int(30 * sy))
                draw_pdf417_tmzc_barcode(draw, bar_x, bar_y, bar_w, max(12, bar_h - int(8 * sy)), tmzc_code)
                tsize = max(8, entry_num(self.e_tmzc_size, 17))
                draw.text(
                    (entry_num(self.e_tmzc_x, 146), entry_num(self.e_tmzc_y, 226)),
                    tmzc_code,
                    font=self.load_font_by_name(self.combo_tmzc_font.get() or "Arial粗体", tsize),
                    fill=(15, 15, 15)
                )
                dot(bar_x, bar_y)
            except Exception:
                pass

        # ④ 中间商标名称 / LOGO
        if self.var_num1.get():
            try:
                nx, ny = entry_num(self.e_num1_x, 636), entry_num(self.e_num1_y, 666)
                nsize = max(10, entry_num(self.e_num1_size, 70))
                centered = self.var_num1_center.get()
                logo_path = self.settings.get("custom_logo_path", "")
                if self.var_use_logo.get() and logo_path and os.path.exists(logo_path):
                    lw = max(8, int(round(setting_num("logo_w", 260) * sx)))
                    lh = max(8, int(round(setting_num("logo_h", 120) * sy)))
                    self.erase_region_if_needed(img, draw, nx, ny, int(560 * sx), int(140 * sy), center_x=centered)
                    logo_img = Image.open(logo_path).convert("RGBA").resize((lw, lh), Image.Resampling.LANCZOS)
                    paste_x = nx - lw // 2 if centered else nx
                    img.paste(logo_img, (paste_x, ny), logo_img)
                    dot(nx, ny)
                elif soft_name:
                    self.draw_single_text(
                        img, draw, soft_name, nx, ny, nsize,
                        self.combo_num1_font.get() or "宋体", (12, 12, 12),
                        center_x=centered, show_dot=show_red_dots,
                        erase_w=int(560 * sx), erase_h=int(130 * sy)
                    )
            except Exception:
                pass

        # ⑤ 核定使用商品/服务项目
        if self.chk_category.get():
            try:
                cat_no = self.e_cat_no.get().strip() or "37"
                items_str = self.e_cat_items.get().strip()
                hx, hy = entry_num(self.e_cat_hx, 92), entry_num(self.e_cat_hy, 913)
                bx, by = entry_num(self.e_cat_bx, 94), entry_num(self.e_cat_by, 968)
                bsize = max(9, entry_num(self.e_cat_bsize, 27))
                hsize = max(10, int(round(setting_num("cat_head_size", 32) * sy)))
                self.draw_wrapped_category_block(img, draw, cat_no, items_str, hx, hy, hsize, bx, by, bsize,
                                                 show_dot=show_red_dots)
            except Exception:
                pass

        # ⑥ 注册人
        if self.chk_company.get() and company_name:
            try:
                self.draw_single_text(
                    img, draw, company_name,
                    entry_num(self.e_comp_x, 276), entry_num(self.e_comp_y, 1106),
                    max(8, entry_num(self.e_comp_size, 29)),
                    self.combo_comp_font.get() or "宋体", (12, 12, 12),
                    show_dot=show_red_dots,
                    erase_w=int(760 * sx), erase_h=int(48 * sy)
                )
            except Exception:
                pass

        # ⑦ 注册人地址
        if self.chk_address.get() and address:
            try:
                self.draw_wrapped_address_block(
                    img, draw, address,
                    entry_num(self.e_addr_x, 276), entry_num(self.e_addr_y, 1252),
                    max(8, entry_num(self.e_addr_size, 28)),
                    self.combo_addr_font.get() or "宋体", show_dot=show_red_dots
                )
            except Exception:
                pass

        # ⑧ 注册日期与有效期至
        if self.chk_dates.get():
            try:
                dsize = max(8, int(round(setting_num("date_size", 27) * sy)))
                for date_text, ex_entry, ey_entry, default_x in (
                    (self.e_reg_date.get().strip(), self.e_rdate_x, self.e_rdate_y, 276),
                    (self.e_exp_date.get().strip(), self.e_edate_x, self.e_edate_y, 676),
                ):
                    if not date_text:
                        continue
                    self.draw_single_text(
                        img, draw, date_text,
                        entry_num(ex_entry, default_x), entry_num(ey_entry, 1433),
                        dsize, "宋体", (12, 12, 12),
                        show_dot=show_red_dots,
                        erase_w=int(215 * sx), erase_h=int(42 * sy)
                    )
            except Exception:
                pass

        # ⑨ 二维码
        if self.var_draw_qr.get():
            try:
                qx = int(round(setting_num("qr_x", 92) * sx))
                qy = int(round(setting_num("qr_y", 1542) * sy))
                qsize = max(40, int(round(setting_num("qr_size", 146) * sx)))
                self.erase_region_if_needed(img, draw, qx - 2, qy - 2, qsize + 6, qsize + 6)
                custom_qr = self.settings.get("custom_qr_path", "")
                if custom_qr and os.path.exists(custom_qr):
                    qr_img = Image.open(custom_qr).convert("RGB").resize((qsize, qsize), Image.Resampling.LANCZOS)
                    img.paste(qr_img, (qx, qy))
                else:
                    draw_simulated_qr(draw, qx, qy, qsize,
                                      f"{tmzc_code}|{reg_no}|{company_name}")
                dot(qx, qy)
            except Exception:
                pass

        # ⑩ 发证机关章
        seal_mode = self.var_seal_mode.get()
        if seal_mode in ("seal1", "seal2"):
            try:
                ssize = max(60, int(round(setting_num("seal_size", 281) * sx)))
                s_pos_x = int(round(setting_num("seal_x", 895) * sx))
                s_pos_y = int(round(setting_num("seal_y", 1389) * sy))
                custom_seal = self.settings.get("custom_seal_path", "")
                if custom_seal and os.path.exists(custom_seal):
                    seal_layer = extract_red_seal_rgba(custom_seal, ssize, style=seal_mode)
                else:
                    seal_layer = build_procedural_cnipa_seal_rgba(ssize, style=seal_mode)
                img.paste(seal_layer, (s_pos_x, s_pos_y), seal_layer)
                dot(s_pos_x, s_pos_y)
            except Exception:
                pass

        return img

    def render_sample_image(self, show_red_dots=True, draw_texts=True):
        tpl_path = self.get_valid_template_path(auto_create_demo=True)
        img = Image.open(tpl_path).convert("RGB")
