    def validate_idcard(self, P):
        if P == "":
            return True
        return bool(re.match(r'^[0-9xX]*$', P)) and len(P) <= 18

    def validate_phone(self, P):
        if P == "":
            return True
        return bool(re.match(r'^[0-9]*$', P)) and len(P) <= 11

