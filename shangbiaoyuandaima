    def _scroll_aligned_rows(self, *args):
        self._scroll_syncing = True
        try:
            self.tree.yview(*args)
            self.route_canvas.yview(*args)
        finally:
            self._scroll_syncing = False

    def _sync_from_tree(self, first, last):
        self.route_scroll.set(first, last)
        if not self._scroll_syncing:
            self._scroll_syncing = True
            try:
                self.route_canvas.yview_moveto(first)
            finally:
                self._scroll_syncing = False

    def _sync_from_route(self, first, last):
        self.route_scroll.set(first, last)
        if not self._scroll_syncing:
            self._scroll_syncing = True
            try:
                self.tree.yview_moveto(first)
            finally:
                self._scroll_syncing = False

    def _scroll_mousewheel(self, event):
        direction = -1 if event.delta > 0 else 1
        self._scroll_aligned_rows("scroll", direction, "units")
        return "break"

    def load_data_to_tree(self):
        for item in self.tree.get_children():
            self.tree.delete(item)
        for widget in self.route_rows_container.winfo_children():
            widget.destroy()
        self.route_widgets.clear()

        data_list = self.app.settings.get("operator_list_data", [])
        combo_vals = []
        for person in data_list:
            tree_id = self.tree.insert("", tk.END, values=(person["name"], person["idcard"], person["phone"]))
            combo_vals.append(f"{person['name']} ({person['phone']})")
            self._create_route_row(person, tree_id)

        self.combo_person["values"] = combo_vals
        if combo_vals:
            self.combo_person.current(0)
            self.on_person_selected(None)

    def _create_route_row(self, person, tree_id):
        phone = str(person.get("phone", ""))
        row_frame = tk.Frame(self.route_rows_container, height=28, bg="#F8FAFC")
        row_frame.pack(fill="x", pady=0)
        row_frame.pack_propagate(False)
        enabled = tk.BooleanVar(value=bool(person.get("sms_enabled", True)))
        check = tk.Checkbutton(
            row_frame, variable=enabled, bg="#F8FAFC",
            command=lambda selected_phone=phone: self._on_route_enabled_changed(selected_phone),
        )
        check.grid(row=0, column=0, padx=4)

        port_entry = tk.Entry(row_frame, width=9, font=("微软雅黑", 9), relief="solid", bd=1)
        port_entry.insert(0, str(person.get("sms_port", self.app.settings.get("sms_com_port", "COM45"))))
        port_entry.grid(row=0, column=1, padx=3)

        url_entry = tk.Entry(row_frame, font=("微软雅黑", 9), relief="solid", bd=1)
        url_entry.insert(0, str(person.get(
            "sms_url", self.app.settings.get("sms_inbox_url", "http://sms.hnyyds.cc:3000/8rsjwle_DkOxrFlFpbOV5g")
        )))
        url_entry.grid(row=0, column=2, sticky="ew", padx=3)
        port_entry.bind("<FocusOut>", lambda _event: self.save_all_popup_coords())
        url_entry.bind("<FocusOut>", lambda _event: self.save_all_popup_coords())
        row_frame.columnconfigure(2, weight=1)

        status_button = tk.Button(
            row_frame, text="待触发", width=10, font=("微软雅黑", 9),
            bg="#E0E0E0", fg="#333333", relief="groove",
            command=lambda selected_phone=phone: self._run_operator_by_phone(selected_phone),
        )
        status_button.grid(row=0, column=3, padx=4)
        self.route_widgets[phone] = {
            "frame": row_frame, "enabled": enabled, "port": port_entry,
            "url": url_entry, "status": status_button, "tree_id": tree_id,
        }

    def _on_route_enabled_changed(self, phone):
        route = self.route_widgets.get(str(phone))
        if not route:
            return
        if route["enabled"].get():
            route["status"].config(text="待触发", bg="#E0E0E0", fg="#333333")
        else:
            route["status"].config(text="未启用", bg="#E0E0E0", fg="#666666")
        self.save_all_popup_coords()

    def _run_operator_by_phone(self, phone):
        for tree_id in self.tree.get_children():
            values = self.tree.item(tree_id, "values")
            if len(values) >= 3 and str(values[2]) == str(phone):
                self.tree.selection_set(tree_id)
                self.tree.see(tree_id)
                self.on_tree_select(None)
                self.run_operator_fill()
                return

    def on_tree_select(self, event):
        sel = self.tree.selection()
        if not sel:
            return
        vals = self.tree.item(sel[0], "values")
        self.e_name.delete(0, tk.END)
        self.e_name.insert(0, vals[0])
        self.e_idcard.delete(0, tk.END)
        self.e_idcard.insert(0, vals[1])
        self.e_phone.delete(0, tk.END)
        self.e_phone.insert(0, vals[2])

    def on_person_selected(self, event):
        sel_str = self.combo_person.get()
        if not sel_str:
            return
        for item in self.tree.get_children():
            vals = self.tree.item(item, "values")
            if f"{vals[0]} ({vals[2]})" == sel_str:
                self.tree.selection_set(item)
                self.tree.see(item)
                self.on_tree_select(None)
                break

    def save_person(self):
        if self._sms_flow_busy:
            messagebox.showwarning("任务处理中", "当前验证码流程结束后再保存下一位运营人。", parent=self)
            return
        name = self.e_name.get().strip()
        idcard = self.e_idcard.get().strip()
        phone = self.e_phone.get().strip()
        route = self.route_widgets.get(phone)
        sms_port = route["port"].get().strip().upper() if route else "COM45"
        sms_url = route["url"].get().strip() if route else self.app.settings.get(
            "sms_inbox_url", "http://sms.hnyyds.cc:3000/8rsjwle_DkOxrFlFpbOV5g"
        )
        sms_enabled = route["enabled"].get() if route else True

        if not name or not idcard or not phone:
            messagebox.showwarning("提示", "姓名、身份证号、手机号均不能为空！", parent=self)
            return
        if not sms_port or not sms_url.startswith(("http://", "https://")):
            messagebox.showwarning("短信通道未配置", "请填写短信端口（如 COM45）和有效的短信页网址。", parent=self)
            return

        self.save_all_popup_coords()
        data_list = self.app.settings.get("operator_list_data", [])
        exists = False
        for p in data_list:
            if p["phone"] == phone:
                p["name"] = name
                p["idcard"] = idcard
                p["sms_enabled"] = sms_enabled
                p["sms_port"] = sms_port
                p["sms_url"] = sms_url
                exists = True
                break
        if not exists:
            data_list.append({
                "name": name, "idcard": idcard, "phone": phone,
                "sms_enabled": sms_enabled, "sms_port": sms_port, "sms_url": sms_url
            })

        self.app.settings["operator_list_data"] = data_list
        self.app.save_config()
        self.load_data_to_tree()
        messagebox.showinfo("成功", f"运营人【{name}】已保存！", parent=self)

    def delete_person(self):
        if self._sms_flow_busy:
            messagebox.showwarning("任务处理中", "当前验证码流程结束后再删除运营人。", parent=self)
            return
        sel = self.tree.selection()
        if not sel:
            messagebox.showwarning("提示", "请先在表格中点击选中要删除的人员！", parent=self)
            return
        vals = self.tree.item(sel[0], "values")
        phone_to_del = vals[2]

        data_list = self.app.settings.get("operator_list_data", [])
        data_list = [p for p in data_list if p["phone"] != phone_to_del]

        self.app.settings["operator_list_data"] = data_list
        self.app.save_config()
        self.load_data_to_tree()


