    def find_record_by_query(self, query_str):
        records = self.app.load_records()
        if query_str in records:
            return query_str, records[query_str]
        for k, v in records.items():
            fname = v.get("file_name", "")
            comp = v.get("company", "")
            if query_str in fname or query_str == f"{comp}_{k}":
                return k, v
        return None, None

