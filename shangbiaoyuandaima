    def _start_sms_code_flow(self, form_url, sms_url, com_port, op_name, op_idcard, op_phone,
                             baseline_id, started_at, source_hwnd=None, route_state=None):
        if not form_url.startswith(("http://", "https://")):
            raise RuntimeError("没有读取到运营人表单网址。请先让浏览器停留在运营人信息页面。")
        if not com_port or not sms_url.startswith(("http://", "https://")):
            raise RuntimeError("请填写有效的短信端口和短信页网址。")
        if not source_hwnd:
            raise RuntimeError("未能记录原运营人浏览器窗口。")
        if self._sms_flow_busy:
            raise RuntimeError("当前验证码流程尚未结束，请稍后再操作。")

        delay = int(self.var_sms_delay.get())
        auto_submit = bool(self.var_auto_submit_sms.get())
        self._sms_flow_busy = True
        self.lbl_copy_status.config(
            text=f"已触发验证码，{delay}秒后开始查询 COM {_sms_port_key(com_port)}（最多30秒）",
            fg="#D97706",
        )
        worker = threading.Thread(
            target=self._sms_code_worker,
            args=(sms_url, com_port, op_phone, source_hwnd, delay, auto_submit,
                  route_state, baseline_id, started_at),
            daemon=True,
        )
        try:
            worker.start()
        except Exception:
            self._sms_flow_busy = False
            raise

    def _sms_code_worker(self, sms_url, com_port, phone, source_hwnd, delay,
                         auto_submit, route_state, baseline_id, started_at):
        def set_status(text, color="#D97706", short_text=None):
            def apply_status():
                try:
                    self.lbl_copy_status.config(text=text, fg=color)
                    if route_state:
                        route_state["status"].config(text=short_text or text, bg=color, fg="white")
                except Exception:
                    pass
            try:
                self.after(0, apply_status)
            except Exception:
                pass

        try:
            deadline = time.monotonic() + 30
            time.sleep(min(delay, max(0, deadline - time.monotonic())))
            set_status(f"软件正在查询 COM {_sms_port_key(com_port)} 的短信记录，30秒时限内……", short_text="查询中")
            code = None
            last_error = None
            while time.monotonic() < deadline:
                try:
                    remaining = max(0.5, deadline - time.monotonic())
                    rows = fetch_sms_history(sms_url, timeout=min(4, remaining))
                    code = find_sms_code(rows, com_port, phone, baseline_id, started_at)
                    last_error = None
                    if code:
                        break
                except Exception as exc:
                    last_error = str(exc)
                time.sleep(1.0)

            if not code:
                detail = f" 接口提示：{last_error}" if last_error else "请核对端口号和手机号尾号。"
                raise TimeoutError(f"30秒内未找到 COM {_sms_port_key(com_port)} 对应的新抖音验证码。{detail}")

            set_status("已找到短信验证码，正在回到运营人表单回填……", short_text="回填中")
            if not focus_window_handle(source_hwnd):
                raise RuntimeError("无法返回原运营人浏览器表单。")

            fill_js = build_douyin_dom_script(
                op_code=code,
                submit_after_code=auto_submit,
                submit_delay_ms=3000,
            )
            execute_js_in_browser_dom(fill_js)
            if auto_submit:
                set_status("验证码已回填，3秒后自动点击提交……", short_text="3秒后提交")
                time.sleep(3.25)
                set_status("已触发提交，等待5秒后恢复运营人操作……", "#D97706", "提交后等待")
                time.sleep(5.0)
                set_status("当前流程已结束，可以继续选择或添加运营人。", "#059669", "可继续")
            else:
                set_status("验证码已回填，可以继续选择或添加运营人。", "#059669", "可继续")
        except Exception as exc:
            error_text = str(exc)
            short_text = "超时" if isinstance(exc, TimeoutError) else "失败"
            set_status(f"验证码任务已结束：{error_text}", "#DC2626", short_text)
        finally:
            def finish_ui():
                self._sms_flow_busy = False
                try:
                    self.deiconify()
                    self.lift()
                    self.focus_set()
                except Exception:
                    pass
            try:
                self.after(0, finish_ui)
            except Exception:
                self._sms_flow_busy = False

    def run_operator_fill(self):
        if self._sms_flow_busy:
            self.lbl_copy_status.config(text="当前验证码流程正在运行，请等它结束后再操作。", fg="#D97706")
