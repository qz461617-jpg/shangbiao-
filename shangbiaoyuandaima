def focus_browser_window():
    try:
        user32 = ctypes.windll.user32
        WNDENUMPROC = ctypes.WINFUNCTYPE(ctypes.c_bool, ctypes.c_void_p, ctypes.c_void_p)
        target_hwnds = []
        fallback_hwnds = []

        def enum_cb(hwnd, lParam):
            if user32.IsWindowVisible(hwnd):
                length = user32.GetWindowTextLengthW(hwnd)
                if length > 0:
                    buf = ctypes.create_unicode_buffer(length + 1)
                    user32.GetWindowTextW(hwnd, buf, length + 1)
                    title = buf.value

                    cls_buf = ctypes.create_unicode_buffer(256)
                    user32.GetClassNameW(hwnd, cls_buf, 256)
                    cls_name = cls_buf.value

                    if "Visual Studio Code" in title or "聚合控制中心" in title or "批量生成" in title:
                        return True

                    if "抖音商家中心" in title or "申请企业机构账号" in title or "business.douyin.com" in title:
                        target_hwnds.append(hwnd)
                    elif cls_name == "Chrome_WidgetWin_1":
                        fallback_hwnds.append(hwnd)
            return True

        user32.EnumWindows(WNDENUMPROC(enum_cb), 0)
        chosen = target_hwnds[0] if target_hwnds else (fallback_hwnds[0] if fallback_hwnds else None)
        if chosen:
            if user32.IsIconic(chosen):
                user32.ShowWindow(chosen, 9)
            user32.SetForegroundWindow(chosen)
            time.sleep(0.25)
            return True
    except Exception:
        pass
    return False


