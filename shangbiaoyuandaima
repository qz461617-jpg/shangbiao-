            yscrollcommand=self.v_scroll.set, xscrollcommand=self.h_scroll.set
        )
        self.canvas.pack(side="left", fill="both", expand=True)
        self.v_scroll.config(command=self.canvas.yview)
        self.h_scroll.config(command=self.canvas.xview)

        self.canvas.bind("<Button-1>", self.on_mouse_click)
        self.canvas.bind("<MouseWheel>", self.on_mouse_wheel)

        self.scale = 0.75
        self.tk_img = None
        self.orig_w = 1280
        self.orig_h = 1810
        self.redraw_template()

    def change_template_in_picker(self):
        if self.app.select_template_image(parent_win=self):
            self.redraw_template()

    def get_zoom_scale(self):
        val = self.combo_zoom.get()
        if "50%" in val:
            return 0.5
        elif "75%" in val:
            return 0.75
        elif "125%" in val:
            return 1.25
        elif "150%" in val:
            return 1.5
        return 1.0

    def redraw_template(self):
        img = self.app.render_sample_image(show_red_dots=self.var_preview_text.get(), draw_texts=self.var_preview_text.get())
        self.orig_w, self.orig_h = img.size

        self.scale = self.get_zoom_scale()
        disp_w = int(self.orig_w * self.scale)
        disp_h = int(self.orig_h * self.scale)

        if self.scale != 1.0:
            img_disp = img.resize((disp_w, disp_h), Image.Resampling.LANCZOS)
        else:
            img_disp = img

        self.tk_img = ImageTk.PhotoImage(img_disp)
        self.canvas.delete("all")
        self.canvas.config(scrollregion=(0, 0, disp_w, disp_h))
        self.canvas.create_image(0, 0, anchor="nw", image=self.tk_img, tags="bg_img")

    def on_mouse_wheel(self, event):
        self.canvas.yview_scroll(int(-1 * (event.delta / 120)), "units")

    def on_mouse_click(self, event):
        cx = self.canvas.canvasx(event.x)
        cy = self.canvas.canvasy(event.y)

        real_x = max(0, min(self.orig_w, int(round(cx / self.scale))))
        real_y = max(0, min(self.orig_h, int(round(cy / self.scale))))
        self.lbl_coord.config(text=f"当前像素: X = {real_x} , Y = {real_y}")

        target_name = self.combo_target.get()
        t_key = self.name_to_key.get(target_name, "none")
        _, entry_x, entry_y = self.field_map.get(t_key, ("", None, None))

        if AUTO_AVAILABLE:
            pyperclip.copy(f"{real_x}, {real_y}")

        if entry_x is not None and entry_y is not None:
            entry_x.delete(0, tk.END)
            entry_x.insert(0, str(real_x))
            entry_y.delete(0, tk.END)
            entry_y.insert(0, str(real_y))
            self.app.save_config()
            self.app.refresh_right_preview()

            self.lbl_tip.config(
                text=f"✅ 已成功将【{target_name}】的坐标更新为: X = {real_x}, Y = {real_y}！"
            )

            if self.var_auto_close.get():
                self.destroy()
                return
            else:
                self.redraw_template()
        else:
            messagebox.showinfo("坐标已复制", f"当前点击位置的像素坐标为：\nX = {real_x}\nY = {real_y}\n\n(已复制到剪贴板)", parent=self)


