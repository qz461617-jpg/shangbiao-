def _sms_port_key(value):
    return re.sub(r"^COM\s*", "", str(value or "").strip(), flags=re.IGNORECASE).lstrip("0") or "0"

def _sms_phone_tail_matches(value, phone):
    phone_digits = re.sub(r"\D", "", str(phone or ""))
    receiver_digits = re.sub(r"\D", "", str(value or ""))
    return bool(phone_digits and receiver_digits and receiver_digits.endswith(phone_digits[-3:]))

def _sms_receiver_value(row):
    for key in ("to", "simnum", "receiver", "phone"):
        value = row.get(key)
        if value is not None and str(value).strip():
            return str(value).strip()
    return ""

def _sms_row_matches_route(row, com_port, phone):
    if _sms_port_key(row.get("com")) != _sms_port_key(com_port):
        return False
    receiver = _sms_receiver_value(row)
    # Some providers omit the receiver from their API payload. In that case
    # use the exact COM channel; when present, also verify the phone suffix.
    return not receiver or _sms_phone_tail_matches(receiver, phone)

def _sms_row_id(row):
    try:
        return int(str(row.get("id", "")).strip())
    except (TypeError, ValueError):
        return None

def _sms_row_timestamp(row):
    value = str(row.get("time", "") or "").strip()
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except (TypeError, ValueError, OverflowError):
        return None

def fetch_sms_history(sms_url, timeout=6):
    parsed = urllib.parse.urlsplit(sms_url)
    route_key = urllib.parse.unquote(parsed.path).strip("/")
    host = (parsed.hostname or "").lower()
    if parsed.scheme not in ("http", "https") or not parsed.netloc or not route_key:
        raise RuntimeError("短信页网址或访问路径无效。")

    if host == "sms.szfangmm.com" or host.endswith("." + SMS_NEXT_HOST_SUFFIX):
        api_origin = f"{parsed.scheme}://{parsed.netloc}"
        api_url = f"{api_origin}/api/smslist?{urllib.parse.urlencode({'token': route_key})}"
        response_format = "array"
    else:
        api_url = f"{SMS_HISTORY_API_BASE}/sms/history?{urllib.parse.urlencode({'path': route_key})}"
        response_format = "envelope"

    request = urllib.request.Request(
        api_url,
        headers={"Accept": "application/json", "User-Agent": "Mozilla/5.0"},
    )
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(request, timeout=timeout) as response:
            payload = json.loads(response.read().decode("utf-8-sig"))
    except Exception as exc:
        raise RuntimeError("连接短信历史接口失败，请检查网络和短信链接。") from exc

    if response_format == "array":
        rows = payload if isinstance(payload, list) else None
    else:
        if not isinstance(payload, dict) or int(payload.get("code", 0) or 0) != 10000:
            raise RuntimeError("短信历史接口未返回成功状态。")
        rows = payload.get("data")
    if not isinstance(rows, list):
        raise RuntimeError("短信历史接口数据格式不正确。")
    return rows

def get_sms_history_baseline(sms_url, com_port, phone):
    rows = fetch_sms_history(sms_url)
    ids = [
        row_id for row in rows
        if isinstance(row, dict)
        and _sms_row_matches_route(row, com_port, phone)
        and (row_id := _sms_row_id(row)) is not None
    ]
    return max(ids, default=0), time.time()

def find_sms_code(rows, com_port, phone, baseline_id, started_at):
    candidates = [row for row in rows if isinstance(row, dict)]
    candidates.sort(key=lambda row: _sms_row_id(row) or 0, reverse=True)
    for row in candidates:
        if not _sms_row_matches_route(row, com_port, phone):
            continue
        row_id = _sms_row_id(row)
        if row_id is not None and row_id <= baseline_id:
            continue
        if row_id is None:
            row_time = _sms_row_timestamp(row)
            if row_time is not None and row_time < started_at - 2:
                continue
        content = str(row.get("content", "") or "")
        if not re.search(r"抖音|douyin", content, re.IGNORECASE):
            continue
        match = SMS_OTP_PATTERN.search(content)
        if match:
            return match.group(1)
    return None


