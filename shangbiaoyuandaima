    def generate_images_task(self):
        try:
            company_lines = [line.strip() for line in self.text_area.get("1.0", tk.END).splitlines() if line.strip()]
            soft_lines = [line.strip() for line in self.soft_text_area.get("1.0", tk.END).splitlines() if line.strip()]
            addr_lines = [line.strip() for line in self.addr_text_area.get("1.0", tk.END).splitlines() if line.strip()]
            tpl_path = self.get_valid_template_path()
            os.makedirs(OUTPUT_DIR, exist_ok=True)

            try:
                start_idx = int(self.e_start_idx.get().strip())
            except ValueError:
                start_idx = 41

            try:
                count_per = max(1, int(self.e_count_per.get().strip()))
            except ValueError:
                count_per = 1

            try:
                step_num1 = int(self.e_num1_step.get().strip())
            except ValueError:
                step_num1 = 1

            try:
                step_reg = int(self.e_reg_step.get().strip())
            except ValueError:
                step_reg = 1

            try:
                step_tmzc = int(self.e_tmzc_step.get().strip())
            except ValueError:
                step_tmzc = 1

            try:
                step_addr = int(self.e_addr_step.get().strip())
            except ValueError:
                step_addr = 0

            base_num1 = self.e_num1_val.get().strip()
            base_reg = self.e_reg_val.get().strip()
            base_tmzc = self.e_tmzc_val.get().strip()
            base_addr = self.e_addr_val.get().strip()
            soft_mode = self.var_soft_mode.get()

            sync_auth = self.var_sync_auth.get()
            auth_comp_val = self.e_auth_company.get().strip()
            auth_start_val = self.e_auth_start.get().strip()
            auth_end_val = self.e_auth_end.get().strip()

            records = self.load_records()
            total_img_index = 0
            success_count = 0
            auth_count = 0
            is_stopped = False

            for c_idx, company_name in enumerate(company_lines):
                if self.stop_requested:
                    is_stopped = True
                    break

                current_group_num = start_idx + c_idx
                used_soft_names = set()
                safe_company = re.sub(r'[\\/:*?"<>|]', '_', company_name)

                if addr_lines:
                    raw_company_addr = addr_lines[c_idx % len(addr_lines)]
                else:
                    raw_company_addr = base_addr

                for sub_idx in range(1, count_per + 1):
                    if self.stop_requested:
                        is_stopped = True
                        break

                    img = Image.open(tpl_path).convert("RGB")

                    cur_reg_no = increment_code(base_reg, total_img_index * step_reg) if (self.var_reg.get() and base_reg) else ""
                    if self.var_tmzc.get() and base_tmzc:
                        if self.var_tmzc_sync.get() and cur_reg_no:
                            cur_tmzc_code = sync_tmzc_with_reg(base_tmzc, base_reg, cur_reg_no, total_img_index, step_tmzc)
                        else:
                            cur_tmzc_code = increment_code(base_tmzc, total_img_index * step_tmzc)
                    else:
                        cur_tmzc_code = ""

                    cur_soft_name = ""
                    if self.var_num1.get():
                        if soft_mode == "num_inc" and base_num1:
                            cur_soft_name = increment_soft_name(base_num1, total_img_index * step_num1)
                        elif soft_mode == "list_inc" and soft_lines:
                            if len(soft_lines) == count_per:
                                raw_s = soft_lines[(sub_idx - 1) % len(soft_lines)]
                                cur_soft_name = increment_soft_name(raw_s, c_idx * step_num1)
                            else:
                                raw_s = soft_lines[total_img_index % len(soft_lines)]
                                cycle_round = total_img_index // len(soft_lines)
                                cur_soft_name = increment_soft_name(raw_s, cycle_round * step_num1)
                        elif soft_mode == "list" and soft_lines:
                            if len(soft_lines) == count_per:
                                cur_soft_name = soft_lines[(sub_idx - 1) % len(soft_lines)]
                            else:
                                cur_soft_name = soft_lines[total_img_index % len(soft_lines)]
                        else:
                            while True:
                                rand_name = random.choice(SOFT_PREFIX) + random.choice(SOFT_MIDDLE) + random.choice(SOFT_SUFFIX)
                                if rand_name not in used_soft_names:
                                    used_soft_names.add(rand_name)
                                    cur_soft_name = rand_name
                                    break

                    cur_address = increment_code(raw_company_addr, total_img_index * step_addr) if (step_addr != 0 and raw_company_addr) else raw_company_addr

                    img = self.render_certificate_elements(
                        img, company_name, cur_soft_name, cur_reg_no, cur_tmzc_code, cur_address, show_red_dots=False
                    )

                    if count_per > 1:
                        code_key = f"{current_group_num}-{sub_idx}"
                    else:
                        code_key = f"{current_group_num}"

                    file_name = f"{safe_company}_{code_key}.png"
                    save_path = os.path.join(OUTPUT_DIR, file_name)
                    img.save(save_path)

                    # 同步一对一生成对应授权书
                    auth_path_str = ""
                    if sync_auth:
                        auth_vals = {
                            "授权方（注册人公司）": company_name,
                            "申请号（右上角第X号）": cur_reg_no or base_reg,
                            "品牌名称": cur_soft_name or base_num1,
                            "授权公司": auth_comp_val,
                            "授权开始日期": auth_start_val,
                            "授权结束日期": auth_end_val
                        }
                        auth_path_str = self.generate_authorization_letter(auth_vals, file_suffix=code_key)
                        auth_count += 1

                    records[code_key] = {
                        "file_name": file_name,
                        "soft_name": cur_soft_name,
                        "company": company_name,
                        "reg_no": cur_reg_no,
                        "tmzc_code": cur_tmzc_code,
                        "address": cur_address,
                        "image_path": os.path.abspath(save_path),
                        "auth_path": auth_path_str
                    }

                    total_img_index += 1
                    success_count += 1

                if is_stopped:
                    break

            self.save_records(records)
            if self.master_popup is not None and self.master_popup.winfo_exists():
                self.root.after(0, self.master_popup.refresh_list)

            if self.var_auto_advance.get() and success_count > 0:
                next_group_idx = start_idx + len(company_lines[:c_idx + (1 if not is_stopped else 0)])

                def update_entries():
                    self.e_start_idx.delete(0, tk.END)
                    self.e_start_idx.insert(0, str(next_group_idx))

                    if base_num1 and soft_mode == "num_inc":
                        self.e_num1_val.delete(0, tk.END)
                        self.e_num1_val.insert(0, increment_soft_name(base_num1, total_img_index * step_num1))

                    if base_reg:
                        next_reg = increment_code(base_reg, total_img_index * step_reg)
                        self.e_reg_val.delete(0, tk.END)
                        self.e_reg_val.insert(0, next_reg)
                        if base_tmzc and self.var_tmzc_sync.get():
                            next_tmzc = sync_tmzc_with_reg(base_tmzc, base_reg, next_reg, total_img_index, step_tmzc)
                            self.e_tmzc_val.delete(0, tk.END)
                            self.e_tmzc_val.insert(0, next_tmzc)
                    elif base_tmzc:
                        self.e_tmzc_val.delete(0, tk.END)
                        self.e_tmzc_val.insert(0, increment_code(base_tmzc, total_img_index * step_tmzc))

                    self.save_config()
                    self.refresh_right_preview()

                self.root.after(0, update_entries)
            else:
                self.root.after(0, self.save_config)

            self.root.after(0, lambda: self.append_log(f"生成完毕！已保存 {success_count} 张证书图片、{auth_count} 份授权书至 output 目录。"))
            msg = f"已中止！保存了 {success_count} 张证书图片与 {auth_count} 份授权书。" if is_stopped else f"成功批量生成 {success_count} 张证书图片 + {auth_count} 份对应授权书！"
            self.root.after(0, lambda: messagebox.showinfo("完成提示", msg))
            self.root.after(0, lambda: os.startfile(os.path.abspath(OUTPUT_DIR)))

        except Exception as e:
            self.root.after(0, lambda: messagebox.showerror("错误", f"生成过程中发生异常：{str(e)}"))
        finally:
            self.is_generating = False
            self.stop_requested = False
            self.root.after(0, lambda: self.btn_generate.config(state="normal", text="1. 批量生成图片"))
            self.root.after(0, lambda: self.btn_stop.config(state="disabled", text="🛑 停止生成"))


if __name__ == "__main__":
    root = tk.Tk()
    app = BatchImageApp(root)
    root.mainloop()
