CERT_INK = (18, 18, 18)
CERT_BLUE = (0, 51, 255)


def load_ttf(font_name, size):
    """按字体名加载 TrueType，逐级回退，保证任何机器都能出字。"""
    size = max(6, int(round(size)))
    for path in (FONT_MAP.get(font_name, ""), FONT_MAP["宋体"], FONT_MAP["微软雅黑"], FONT_COMPANY):
        if path and os.path.exists(path):
            try:
                return ImageFont.truetype(path, size)
            except Exception:
                continue
    try:
        return ImageFont.load_default()
    except Exception:
        return None


def text_width(draw, text, font):
    if not text:
        return 0.0
    try:
        return draw.textlength(text, font=font)
    except Exception:
        return len(text) * 10.0


def draw_tracked_text(draw, x, y, text, font, fill=CERT_INK, tracking=0.0,
                      center_x=None, stroke_width=0):
    """逐字绘制以支持字距；给出 center_x 时按总宽水平居中。返回总宽。"""
    if not text:
        return 0.0
    advances = [text_width(draw, ch, font) for ch in text]
    total = sum(advances) + tracking * max(0, len(text) - 1)
    cur = center_x - total / 2.0 if center_x is not None else x
    for ch, adv in zip(text, advances):
        draw.text((cur, y), ch, font=font, fill=fill,
                  stroke_width=stroke_width, stroke_fill=fill)
        cur += adv + tracking
    return total


def draw_label_text(draw, x, y, text, font, total_w, fill=CERT_INK):
    """把标签字符均摊到 total_w 宽度内，还原证书上“注 册 人”这类等宽对齐。"""
    chars = [c for c in text if c.strip()]
    if not chars:
        return 0.0
    widths = [text_width(draw, c, font) for c in chars]
    gap = (total_w - sum(widths)) / (len(chars) - 1) if len(chars) > 1 else 0.0
    cur = x
    for ch, w in zip(chars, widths):
        draw.text((cur, y), ch, font=font, fill=fill)
        cur += w + gap
    return total_w


def draw_director_signature(img, x, y, name="申长雨", font_size=128, ink=(22, 22, 22)):
    """局长签名：优先用行楷书写，缺字体时退化为宋体。"""
    name = (name or "").strip()
    if not name:
        return
    font = load_ttf("行楷", font_size)
    probe = ImageDraw.Draw(Image.new("RGBA", (8, 8)))
    try:
        bbox = probe.textbbox((0, 0), name, font=font)
        text_w = bbox[2] - bbox[0]
    except Exception:
        bbox, text_w = (0, 0, font_size * len(name), font_size), font_size * len(name)
    pad = max(12, int(font_size * 0.35))
    tile = Image.new("RGBA", (int(text_w) + pad * 2, int(font_size * 1.7) + pad),
                     (0, 0, 0, 0))
    td = ImageDraw.Draw(tile)
    td.text((pad - bbox[0], pad - bbox[1]), name, font=font, fill=ink + (255,),
            stroke_width=max(1, int(font_size * 0.012)), stroke_fill=ink + (255,))
    tile = tile.rotate(-2.5, resample=Image.Resampling.BICUBIC, expand=False)
    img.paste(tile, (int(x), int(y)), tile)


