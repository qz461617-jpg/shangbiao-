def draw_pdf417_tmzc_barcode(draw, x, y, width, height, seed_str):
    """绘制接近 PDF417 的条码块：起止符 + 三行数据条 + 行分隔，视觉密度对齐证书原样。"""
    x, y = int(round(x)), int(round(y))
    width, height = max(60, int(round(width))), max(18, int(round(height)))
    ink = (10, 10, 10)
    digest = hashlib.sha256((seed_str or "TMZC").encode("utf-8")).digest()
    rows = 3
    gap = 1 if height >= 28 else 0
    row_h = max(3, (height - gap * (rows - 1)) // rows)
    unit = max(1.0, width / 190.0)

    def bar(bx, bw, ry0, ry1):
        w = max(1, int(round(bw)))
        draw.rectangle([(int(round(bx)), int(ry0)), (int(round(bx)) + w - 1, int(ry1))], fill=ink)

    for r in range(rows):
        ry0 = y + r * (row_h + gap)
        ry1 = ry0 + row_h - 1
        bar(x, unit * 3.0, ry0, ry1)
        bar(x + unit * 4.4, unit * 1.2, ry0, ry1)
        cx = x + unit * 7.2
        end = x + width - unit * 11.0
        idx = r * 7
        while cx < end:
            b_val = digest[idx % len(digest)]
            span = unit * (1.0 + (b_val & 3) * 0.9)
            if (b_val >> (idx % 5)) & 1 or (idx % 7 == 0):
                bar(cx, span, ry0, ry1)
            cx += span + unit * 0.75
            idx += 1
        tx = x + width - unit * 10.0
        bar(tx, unit * 2.6, ry0, ry1)
        for k in range(3):
            bar(tx + unit * (3.6 + k * 1.7), unit * 0.9, ry0, ry1)


def draw_simulated_qr(draw, x, y, size, seed_text):
    """绘制结构完整的二维码占位图：三定位符、分隔符、时序线、对齐符、数据区与静区。"""
    x, y = int(round(x)), int(round(y))
    size = max(56, int(round(size)))
    modules = 29
    cell = size / float(modules)
    ink = (14, 14, 14)
    white = (255, 255, 255)

    draw.rectangle([(x - int(cell), y - int(cell)),
                    (x + size + int(cell) - 1, y + size + int(cell) - 1)], fill=white)

    def rect(c, r, w=1, h=1, fill=ink):
        x0 = x + int(round(c * cell))
        y0 = y + int(round(r * cell))
        x1 = x + int(round((c + w) * cell)) - 1
        y1 = y + int(round((r + h) * cell)) - 1
        draw.rectangle([(x0, y0), (x1, y1)], fill=fill)

    def finder(c0, r0):
        rect(c0, r0, 7, 7, ink)
        rect(c0 + 1, r0 + 1, 5, 5, white)
        rect(c0 + 2, r0 + 2, 3, 3, ink)

    def align(c0, r0):
        rect(c0, r0, 5, 5, ink)
        rect(c0 + 1, r0 + 1, 3, 3, white)
        rect(c0 + 2, r0 + 2, 1, 1, ink)

    reserved = set()

    def reserve(c0, r0, w, h):
        for c in range(c0, c0 + w):
            for r in range(r0, r0 + h):
                reserved.add((c, r))

    finder(0, 0); reserve(0, 0, 8, 8)
    finder(modules - 7, 0); reserve(modules - 8, 0, 8, 8)
    finder(0, modules - 7); reserve(0, modules - 8, 8, 8)
    align(22, 22); reserve(22, 22, 5, 5)

    for i in range(8, modules - 8):
        if i % 2 == 0:
            rect(i, 6, fill=ink)
            rect(6, i, fill=ink)
        reserved.add((i, 6))
        reserved.add((6, i))

    digest = hashlib.sha256((seed_text or "TMZC").encode("utf-8")).digest()
    bit = 0
    for r in range(modules):
        for c in range(modules):
            if (c, r) in reserved:
                continue
            byte_val = digest[(bit // 8) % len(digest)]
            if (byte_val >> (bit % 8)) & 1:
                rect(c, r, fill=ink)
            bit += 1


