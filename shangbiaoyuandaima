    def generate_authorization_letter(self, values, file_suffix=""):
        """按授权书参考版式排版：黑体标题、宋体正文、首行缩进两字、页脚签章区带圆章。"""
        width, height = 1240, 1754
        img = Image.new("RGB", (width, height), (255, 255, 255))
        draw = ImageDraw.Draw(img)

        title_font = load_ttf("黑体", 50)
        body_font = load_ttf("宋体", 35)
        ink = (16, 16, 16)

        margin_x = 84
        content_w = 1050
        line_h = 50
        indent = 66

        def split_tokens(text):
            """连续英文/数字串整体参与折行；开引号与句读标点分别贴住相邻字，避免行首行末落单。"""
            no_start = "，。、；：？！）〕》」』”’,.;:?!)]}"
            no_end = "（〔《「『“‘([{"
            tokens, buf = [], ""
            for ch in text:
                if ord(ch) < 128 and not ch.isspace() and ch not in ",.;:!?'\"()[]{}<>":
                    buf += ch
                else:
                    if buf:
                        tokens.append(buf)
                        buf = ""
                    tokens.append(ch)
            if buf:
                tokens.append(buf)
            merged, pending = [], ""
            for tk in tokens:
                if pending:
                    tk = pending + tk
                    pending = ""
                if tk and tk[-1] in no_end:
                    pending = tk
                    continue
                merged.append(tk)
            if pending:
                merged.append(pending)
            final = []
            for tk in merged:
                if tk and tk[0] in no_start and final:
                    final[-1] += tk
                else:
                    final.append(tk)
            return final

        def wrap(text, start_y, first_indent=0, bold=False):
            """按 token 折行：首行缩进，续行顶格；返回下一行起点。"""
            tokens = split_tokens(text)
            line = ""
            y = start_y
            first = True
            stroke = 1 if bold else 0
            for tk in tokens:
                limit = content_w - (first_indent if first else 0)
                if line and draw.textlength(line + tk, font=body_font) > limit:
                    draw.text((margin_x + (first_indent if first else 0), y), line,
                              font=body_font, fill=ink, stroke_width=stroke, stroke_fill=ink)
                    y += line_h
                    line = tk
                    first = False
                else:
                    line += tk
            if line:
                draw.text((margin_x + (first_indent if first else 0), y), line,
                          font=body_font, fill=ink, stroke_width=stroke, stroke_fill=ink)
                y += line_h
            return y

        title = "授权书"
        t_box = draw.textbbox((0, 0), title, font=title_font)
        draw.text(((width - (t_box[2] - t_box[0])) / 2, 142 - t_box[1]),
                  title, font=title_font, fill=ink)

        licensor = values.get("授权方（注册人公司）", "").strip() or "授权方"
        brand = values.get("品牌名称", "").strip() or "授权品牌"
        reg_no = values.get("申请号（右上角第X号）", "").strip()
        grantee = values.get("授权公司", "").strip() or "被授权方"
        start_d = values.get("授权开始日期", "").strip()
        end_d = values.get("授权结束日期", "").strip()

        y = 318
        y = wrap(f"兹有 {licensor}（授权方）为品牌“{brand}”（商标注册证号 / 申请号：{reg_no}）的合法持有者。",
                 y, first_indent=indent)
        y = wrap(f"特授权 {grantee} 在如下范围内使用授权品牌。", y + 4, first_indent=indent)

        y += 100
        draw.text((margin_x, y), "一、授权渠道", font=body_font, fill=ink,
                  stroke_width=1, stroke_fill=ink)
        y += line_h

        p1 = ("1、被授权方有权在抖音电商平台(域名：jinritemai.com)使用授权品牌开设店铺，"
              "品牌使用范围包括店铺名称(具体以平台审核通过为准)、店铺LOGO、宣传素材等，"
              "并有权开展授权品牌相关商品的销售、推广活动；")
        p2 = ("2、被授权方有权在抖音平台(域名：douyin.com)使用授权品牌申请认证个体店企业号，"
              "或以授权品牌专卖店作为其抖音企业号昵称，品牌使用范围包括昵称(具体以平台审核通过为准)、"
              "认证信息、账号头像等。")
        y = wrap(p1, y)
        y = wrap(p2, y)

        y += line_h
        draw.text((margin_x, y), f"二、授权期间自：{start_d}至{end_d}",
                  font=body_font, fill=ink, stroke_width=1, stroke_fill=ink)
        y += line_h

        sign_y = max(y + line_h * 2, 1222)
        draw.text((margin_x, sign_y), "特此授权。", font=body_font, fill=ink)
        label_y = sign_y + line_h
        draw.text((margin_x, label_y), "授权方(盖章或签字)：", font=body_font, fill=ink)

        seal_mode = self.var_auth_seal_mode.get()
        seal_size = 258
        seal_left, seal_top = 398, label_y - 169
        custom_seal_path = self.settings.get("custom_auth_seal_path", "")
        if seal_mode == "custom" and custom_seal_path and os.path.exists(custom_seal_path):
            seal_rgba = extract_red_seal_rgba(custom_seal_path, target_size=seal_size, style="seal1")
            img.paste(seal_rgba, (seal_left, seal_top), seal_rgba)
        elif seal_mode == "auto":
            seal_rgba = build_company_circular_seal_rgba(licensor, seal_size)
            img.paste(seal_rgba, (seal_left, seal_top), seal_rgba)

        out_dir = os.path.join(OUTPUT_DIR, "授权书")
        os.makedirs(out_dir, exist_ok=True)
        safe_comp = re.sub(r'[\\/:*?"<>|]', "_", licensor)
        safe_brand = re.sub(r'[\\/:*?"<>|]', "_", brand)
        safe_no = re.sub(r'[\\/:*?"<>|]', "_", reg_no)
        suffix_tag = f"_{file_suffix}" if file_suffix else ""
        out_path = os.path.abspath(os.path.join(out_dir, f"授权书_{safe_comp}_{safe_brand}_{safe_no}{suffix_tag}.png"))
        img.save(out_path, dpi=(150, 150))
        return out_path

