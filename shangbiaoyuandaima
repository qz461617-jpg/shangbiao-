    def get_all_category_presets(self):
        saved_presets = self.settings.get("custom_category_presets", {})
        if not isinstance(saved_presets, dict) or not saved_presets:
            saved_presets = DEFAULT_CATEGORY_PRESETS.copy()
        else:
            merged = DEFAULT_CATEGORY_PRESETS.copy()
            merged.update(saved_presets)
            saved_presets = merged
        self.settings["custom_category_presets"] = saved_presets
        return saved_presets

    def on_select_category_preset(self, event=None):
        sel_key = self.combo_cat_preset.get()
        presets = self.get_all_category_presets()
        if sel_key in presets:
            item_data = presets[sel_key]
            if isinstance(item_data, dict):
                cat_no = str(item_data.get("cat_no", sel_key[:2]))
                items_txt = str(item_data.get("items", ""))
            else:
                cat_no = sel_key[:2]
                items_txt = str(item_data)

            self.e_cat_no.delete(0, tk.END)
            self.e_cat_no.insert(0, str(int(cat_no)) if cat_no.isdigit() else cat_no)
            self.e_cat_items.delete(0, tk.END)
            self.e_cat_items.insert(0, items_txt)
            self.refresh_right_preview()
            self.append_log(f"已切换分类预设：【{sel_key}】")

    def open_add_category_popup(self):
        if self.add_cat_popup is not None and self.add_cat_popup.winfo_exists():
            self.add_cat_popup.lift()
        else:
            self.add_cat_popup = AddCategoryPresetPopup(self.root, self)

    def quick_save_current_category_preset(self):
        cat_no = self.e_cat_no.get().strip()
        items_str = self.e_cat_items.get().strip()
        if not cat_no or not items_str:
            messagebox.showwarning("提示", "请先填写分类号和小类明细文字！")
            return
        if not items_str.endswith(" ") and not items_str.endswith("(截止)"):
            items_str += " "
            self.e_cat_items.delete(0, tk.END)
            self.e_cat_items.insert(0, items_str)

        clean_head = re.sub(r'[；;，,（(].*$', '', items_str)[:6] or "自定义"
        preset_key = f"{cat_no}类-{clean_head}"

        presets = self.get_all_category_presets()
        presets[preset_key] = {"cat_no": cat_no, "items": items_str}
        self.settings["custom_category_presets"] = presets

        self.combo_cat_preset["values"] = list(presets.keys())
        self.combo_cat_preset.set(preset_key)
        self.save_config()
        self.refresh_right_preview()
        self.append_log(f"已将当前分类快速保存至一键预设：【{preset_key}】")
        messagebox.showinfo("保存成功", f"已将【{preset_key}】保存至一键预设下拉列表！")

    def delete_current_category_preset(self):
        sel_key = self.combo_cat_preset.get().strip()
        if not sel_key:
            return
        presets = self.get_all_category_presets()
        if len(presets) <= 1:
            messagebox.showwarning("提示", "至少需要保留一个分类预设！")
            return
        if messagebox.askyesno("确认删除", f"确定要从一键预设中删除【{sel_key}】吗？"):
            presets.pop(sel_key, None)
            self.settings["custom_category_presets"] = presets
            keys = list(presets.keys())
            self.combo_cat_preset["values"] = keys
            if keys:
                self.combo_cat_preset.set(keys[0])
                self.on_select_category_preset()
            self.save_config()
            self.append_log(f"已删除分类预设：【{sel_key}】")

