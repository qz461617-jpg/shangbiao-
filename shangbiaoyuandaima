def extract_emblem_rgba(img_path, target_w=246, target_h=268, style="emblem1"):
    cache_key = ("emblem", img_path, target_w, target_h, style)
    if cache_key in _IMAGE_CACHE:
        return _IMAGE_CACHE[cache_key].copy()

    src = Image.open(img_path).convert("RGBA")
    w, h = src.size
    px = src.load()

    min_x, min_y, max_x, max_y = w, h, 0, 0
    for y in range(h):
        for x in range(w):
            r, g, b, a = px[x, y]
            if a > 30 and not (r > 235 and g > 235 and b > 235):
                if x < min_x:
                    min_x = x
                if x > max_x:
                    max_x = x
                if y < min_y:
                    min_y = y
                if y > max_y:
                    max_y = y

    if max_x > min_x and max_y > min_y:
        src = src.crop((min_x, min_y, max_x + 1, max_y + 1))

    src = src.resize((max(1, target_w), max(1, target_h)), Image.Resampling.LANCZOS)
    s_px = src.load()
    for y in range(src.height):
        for x in range(src.width):
            r, g, b, a = s_px[x, y]
            if r > 238 and g > 238 and b > 238:
                s_px[x, y] = (255, 255, 255, 0)
            elif style == "emblem2":
                s_px[x, y] = (min(255, int(r * 1.06)), max(0, int(g * 0.94)), b, a)

    _IMAGE_CACHE[cache_key] = src
    return src.copy()


def extract_red_seal_rgba(img_path, target_size=278, style="seal1"):
    cache_key = ("seal", img_path, target_size, style)
    if cache_key in _IMAGE_CACHE:
        return _IMAGE_CACHE[cache_key].copy()

    src = Image.open(img_path).convert("RGBA")
    w, h = src.size
    px = src.load()

    min_x, min_y, max_x, max_y = w, h, 0, 0
    for y in range(h):
        for x in range(w):
            r, g, b, a = px[x, y]
            if a > 40 and r > 145 and (r - g) > 35 and (r - b) > 35:
                if x < min_x:
                    min_x = x
                if x > max_x:
                    max_x = x
                if y < min_y:
                    min_y = y
                if y > max_y:
                    max_y = y

    if max_x > min_x and max_y > min_y:
        pad = 4
        src = src.crop((max(0, min_x - pad), max(0, min_y - pad), min(w, max_x + pad + 1), min(h, max_y + pad + 1)))

    target_size = max(1, target_size)
    src = src.resize((target_size, target_size), Image.Resampling.LANCZOS)
    s_px = src.load()
    out = Image.new("RGBA", (target_size, target_size), (0, 0, 0, 0))
    o_px = out.load()

    for y in range(target_size):
        for x in range(target_size):
            r, g, b, a = s_px[x, y]
            redness = r - max(g, b)
            if r > 125 and redness > 20:
                alpha = min(255, int(redness * 2.25))
                if style == "seal2":
                    o_px[x, y] = (195, 16, 16, alpha)
                else:
                    o_px[x, y] = (232, 20, 20, alpha)

    _IMAGE_CACHE[cache_key] = out
    return out.copy()


def draw_star_polygon(draw, cx, cy, r_outer, angle_deg=0, fill=(250, 215, 45), outline=None):
    pts = []
    r_inner = r_outer * 0.382
    for i in range(10):
        ang = math.radians(angle_deg - 90 + i * 36)
        r = r_outer if i % 2 == 0 else r_inner
        pts.append((cx + r * math.cos(ang), cy + r * math.sin(ang)))
    draw.polygon(pts, fill=fill, outline=outline)


def build_company_circular_seal_rgba(company_name, size=290, style="ink"):
    """生成印泥质感授权方圆章：细外环带缺墨、环形宋体名称、实心五角星、点状麻面。"""
    clean_name = (company_name or "").strip() or "授权方专用章"
    cache_key = ("company_circular_seal_v3", clean_name, int(size), style)
    if cache_key in _IMAGE_CACHE:
        return _IMAGE_CACHE[cache_key].copy()

    S = 760
    overlay = Image.new("RGBA", (S, S), (0, 0, 0, 0))
    d = ImageDraw.Draw(overlay)
    ink = (223, 42, 46)
    rng = random.Random(int(hashlib.md5(clean_name.encode("utf-8")).hexdigest()[:12], 16))

    cx = cy = S // 2
    R = int(S * 0.450)
    ring_w = max(3, int(S * 0.023))

    # 环上留 1~2 处缺墨，模拟按压力度中段变浅
    gap_centers = [rng.uniform(0, 360) for _ in range(2)]
    gap_widths = [rng.uniform(12, 26) for _ in range(2)]

    def gap_factor(a):
        for gc, gw in zip(gap_centers, gap_widths):
            dist = abs((a - gc + 180.0) % 360.0 - 180.0)
            if dist < gw / 2.0:
                return 0.30 + dist / gw * 1.6
        return 1.0

    # 完整外环，深浅由印泥噪声自然形成
    d.ellipse([(cx - R, cy - R), (cx + R, cy + R)], outline=ink + (236,), width=ring_w)

    # 环形公司名：细宋体，字距拉开
    n = len(clean_name)
    if n <= 10:
        font_size = int(S * 0.108)
    elif n <= 14:
        font_size = int(S * 0.098)
    else:
        font_size = max(int(S * 0.078), int(S * 1.45 / n))
    font = load_ttf("宋体", font_size)
    span = min(255.0, 120.0 + n * 10.8)
    step = span / max(1, n - 1)
    start = -span / 2.0
    radius = R - int(font_size * 0.95)
    tile = int(font_size * 1.9)
    for i, ch in enumerate(clean_name):
        ang = start + i * step
        char_img = Image.new("RGBA", (tile, tile), (0, 0, 0, 0))
        cd = ImageDraw.Draw(char_img)
        bbox = cd.textbbox((0, 0), ch, font=font)
        cd.text(((tile - (bbox[2] - bbox[0])) / 2 - bbox[0],
                 (tile - (bbox[3] - bbox[1])) / 2 - bbox[1]),
                ch, font=font, fill=ink + (222,))
        rot = char_img.rotate(-ang, resample=Image.Resampling.BICUBIC, expand=False)
        rad = math.radians(ang - 90)
        px = int(cx + radius * math.cos(rad) - tile / 2 + rng.uniform(-1.8, 1.8))
        py = int(cy + radius * math.sin(rad) - tile / 2 + rng.uniform(-1.8, 1.8))
        overlay.alpha_composite(rot, (px, py))

    # 中心五角星
    star_r = int(S * 0.128)
    pts = []
    for i in range(10):
        a = math.radians(-90 + i * 36)
        rr = (star_r if i % 2 == 0 else star_r * 0.382) * rng.uniform(0.98, 1.02)
        pts.append((cx + rr * math.cos(a), cy + rr * math.sin(a)))
    d.polygon(pts, fill=ink + (226,))

    # 印泥麻面：低频块斑 × 高频二值麻点，调制透明度后软阈值出毛边
    try:
        coarse = Image.effect_noise((max(8, S // 44), max(8, S // 44)), 58)
        coarse = coarse.resize((S, S), Image.Resampling.BICUBIC)
        coarse = coarse.point(lambda v: 255 if v > 116 else (228 if v > 90 else 194))
        fine = Image.effect_noise((S, S), 88)
        fine = fine.point(lambda v: 255 if v > 112 else 198)
        mask = ImageChops.multiply(coarse, fine)
    except Exception:
        mask = Image.new("L", (S, S), 225)

    r_ch, g_ch, b_ch, a_ch = overlay.split()
    a_ch = ImageChops.multiply(a_ch, mask)
    a_ch = a_ch.filter(ImageFilter.GaussianBlur(0.55))
    a_ch = a_ch.point(lambda v: 0 if v < 60 else (255 if v > 214 else int((v - 60) * 1.58)))
    seal = Image.merge("RGBA", (r_ch, g_ch, b_ch, a_ch))

    res = seal.resize((max(1, int(size)), max(1, int(size))), Image.Resampling.LANCZOS)
    _IMAGE_CACHE[cache_key] = res
    return res.copy()


def build_procedural_emblem_rgba(width=246, height=268, style="emblem1"):
    """程序化绘制国徽：红底金环、五颗金星、天安门城楼、齿轮与麦穗环抱。"""
    cache_key = ("proc_emblem_v3", width, height, style)
    if cache_key in _IMAGE_CACHE:
        return _IMAGE_CACHE[cache_key].copy()

    S = 760
    img = Image.new("RGBA", (S, S), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)

    red_main = (223, 22, 28, 255) if style == "emblem1" else (197, 15, 20, 255)
    gold_main = (247, 203, 52, 255)
    gold_dark = (168, 112, 20, 255)

    cx, cy = S // 2, S // 2 - 8
    R = int(S * 0.465)

    def rot_ellipse(ecx, ecy, rx, ry, angle_deg, fill, outline=None, ow=0):
        a = math.radians(angle_deg)
        pts = []
        for i in range(26):
            t = 2 * math.pi * i / 26
            ex, ey = rx * math.cos(t), ry * math.sin(t)
            pts.append((ecx + ex * math.cos(a) - ey * math.sin(a),
                        ecy + ex * math.sin(a) + ey * math.cos(a)))
        d.polygon(pts, fill=fill, outline=outline, width=ow)

    # 金环与红底
    d.ellipse([(cx - R, cy - R), (cx + R, cy + R)], fill=gold_main, outline=gold_dark, width=7)
    d.ellipse([(cx - R + 15, cy - R + 15), (cx + R - 15, cy + R - 15)],
              fill=red_main, outline=gold_dark, width=3)

    # 左右麦穗：沿内缘向上环绕的麦粒 + 麦秆
    for side in (-1, 1):
        stem = []
        for i in range(9):
            t = i / 8.0
            th = math.radians(95 - side * 84 * t)
            rr = R * (0.84 - 0.19 * t)
            gx, gy = cx + rr * math.cos(th), cy + rr * math.sin(th)
            stem.append((gx, gy))
            rot_ellipse(gx, gy, S * 0.021, S * 0.045,
                        math.degrees(th) + 90, gold_main, gold_dark, 2)
        if len(stem) > 1:
            d.line(stem, fill=gold_dark, width=5)

    # 齿轮
    g_cx, g_cy = cx, cy + int(R * 0.55)
    g_r = int(S * 0.086)
    for k in range(20):
        a = math.radians(k * 18)
        tx = g_cx + (g_r + int(S * 0.011)) * math.cos(a)
        ty = g_cy + (g_r + int(S * 0.011)) * math.sin(a)
        half = int(S * 0.012)
        d.rectangle([(tx - half, ty - half), (tx + half, ty + half)],
                    fill=gold_main, outline=gold_dark, width=2)
    d.ellipse([(g_cx - g_r, g_cy - g_r), (g_cx + g_r, g_cy + g_r)],
              fill=gold_main, outline=gold_dark, width=4)
    d.ellipse([(g_cx - int(g_r * 0.62), g_cy - int(g_r * 0.62)),
               (g_cx + int(g_r * 0.62), g_cy + int(g_r * 0.62))],
              fill=red_main, outline=gold_dark, width=3)

    # 天安门：屋顶 + 城楼 + 城台 + 五门洞
    roof_y = cy - int(S * 0.055)
    d.polygon([(cx - int(S * 0.225), roof_y + int(S * 0.022)),
               (cx + int(S * 0.225), roof_y + int(S * 0.022)),
               (cx + int(S * 0.185), roof_y - int(S * 0.026)),
               (cx - int(S * 0.185), roof_y - int(S * 0.026))],
              fill=gold_main, outline=gold_dark)
    d.rectangle([(cx - int(S * 0.185), roof_y + int(S * 0.022)),
                 (cx + int(S * 0.185), roof_y + int(S * 0.062))],
                fill=gold_main, outline=gold_dark, width=3)
    d.rectangle([(cx - int(S * 0.155), roof_y + int(S * 0.062)),
                 (cx + int(S * 0.155), roof_y + int(S * 0.130))],
                fill=gold_main, outline=gold_dark, width=3)
    wall_top = roof_y + int(S * 0.130)
    wall_bottom = roof_y + int(S * 0.196)
    d.rectangle([(cx - int(S * 0.215), wall_top), (cx + int(S * 0.215), wall_bottom)],
                fill=gold_main, outline=gold_dark, width=3)
    for off, dw in [(-0.150, 0.030), (-0.077, 0.024), (0.0, 0.034), (0.077, 0.024), (0.150, 0.030)]:
        dx = cx + int(S * off)
        half = max(3, int(S * dw))
        d.rectangle([(dx - half, wall_top + int(S * 0.014)), (dx + half, wall_bottom - 2)],
                    fill=red_main)

    # 五颗金星
    draw_star_polygon(d, cx, cy - int(R * 0.42), int(S * 0.072), 0,
                      fill=gold_main, outline=gold_dark)
    small_r = int(S * 0.028)
    for ox, oy, ang in [(-int(S * 0.092), -int(R * 0.293), -33),
                        (-int(S * 0.038), -int(R * 0.243), -13),
                        (int(S * 0.038), -int(R * 0.243), 13),
                        (int(S * 0.092), -int(R * 0.293), 33)]:
        draw_star_polygon(d, cx + ox, cy + oy, small_r, ang,
                          fill=gold_main, outline=gold_dark)

    # 底部绶带
    rib_y = cy + int(R * 0.77)
    d.polygon([(cx - int(S * 0.155), rib_y), (cx + int(S * 0.155), rib_y),
               (cx + int(S * 0.120), rib_y + int(S * 0.042)),
               (cx - int(S * 0.120), rib_y + int(S * 0.042))],
              fill=gold_main, outline=gold_dark)

    res = img.resize((max(1, int(width)), max(1, int(height))), Image.Resampling.LANCZOS)
    _IMAGE_CACHE[cache_key] = res
    return res.copy()


def _draw_mono_emblem(d, cx, cy, R, color):
    """红色单色版国徽图案，用于发证机关章的章心。"""
    lw = max(2, int(R * 0.05))
    d.ellipse([(cx - R, cy - R), (cx + R, cy + R)], outline=color, width=lw)
    draw_star_polygon(d, cx, cy - R * 0.52, R * 0.22, 0, fill=color)
    for ox, oy, ang in [(-0.30 * R, -0.21 * R, -30), (-0.13 * R, -0.04 * R, -12),
                        (0.13 * R, -0.04 * R, 12), (0.30 * R, -0.21 * R, 30)]:
        draw_star_polygon(d, cx + ox, cy + oy, R * 0.080, ang, fill=color)
    # 天安门：屋顶 + 城楼 + 城台 + 门洞
    d.polygon([(cx - R * 0.50, cy + R * 0.04), (cx + R * 0.50, cy + R * 0.04),
               (cx + R * 0.42, cy - R * 0.08), (cx - R * 0.42, cy - R * 0.08)], fill=color)
    d.rectangle([(cx - R * 0.40, cy + R * 0.04), (cx + R * 0.40, cy + R * 0.22)], fill=color)
    for k in range(-2, 3):
        dx = cx + k * R * 0.16
        d.rectangle([(dx - R * 0.032, cy + R * 0.20), (dx + R * 0.032, cy + R * 0.34)],
                    fill=None, outline=color, width=max(1, lw - 1))
    # 齿轮环
    d.ellipse([(cx - R * 0.30, cy + R * 0.34), (cx + R * 0.30, cy + R * 0.90)],
              outline=color, width=lw)
    for k in range(12):
        a = math.radians(k * 30)
        gx = cx + R * 0.30 * math.cos(a)
        gy = cy + R * 0.62 + R * 0.28 * math.sin(a)
        d.ellipse([(gx - R * 0.045, gy - R * 0.045), (gx + R * 0.045, gy + R * 0.045)],
                  fill=color)
    # 麦穗
    for side in (-1, 1):
        for i in range(6):
            t = i / 5.0
            ang = math.radians(95 - side * 80 * t)
            gx = cx + (R * 0.76) * math.cos(ang)
            gy = cy + (R * 0.76) * math.sin(ang)
            d.ellipse([(gx - R * 0.062, gy - R * 0.038),
                       (gx + R * 0.062, gy + R * 0.038)], fill=color)


