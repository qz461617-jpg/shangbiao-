def build_douyin_dom_script(soft_name=None, company=None, reg_no=None, tiktok_name=None,
                            op_name=None, op_idcard=None, op_phone=None, click_code=False,
                            trigger_upload_idx=0, op_code=None, submit_after_code=False, submit_delay_ms=3000):
    data_obj = {
        "soft_name": soft_name,
        "company": company,
        "reg_no": reg_no,
        "tiktok_name": tiktok_name,
        "op_name": op_name,
        "op_idcard": op_idcard,
        "op_phone": op_phone,
        "click_code": bool(click_code),
        "trigger_upload_idx": trigger_upload_idx,
        "op_code": op_code,
        "submit_after_code": bool(submit_after_code),
        "submit_delay_ms": int(submit_delay_ms)
    }
    data_json = json.dumps(data_obj, ensure_ascii=False)

    js = f"""
    const D = {data_json};
    function setReactVal(el, val) {{
        if (!el || val === null || val === undefined) return false;
        el.scrollIntoView({{ block: 'center', behavior: 'instant' }});
        el.focus();
        el.click();
        const proto = el.tagName === 'TEXTAREA' ? window.HTMLTextAreaElement.prototype : window.HTMLInputElement.prototype;
        const setter = Object.getOwnPropertyDescriptor(proto, 'value')?.set;
        const oldVal = el.value;
        if (setter) {{ setter.call(el, val); }} else {{ el.value = val; }}
        if (el._valueTracker) {{ el._valueTracker.setValue(oldVal); }}
        el.dispatchEvent(new Event('input', {{ bubbles: true }}));
        el.dispatchEvent(new Event('change', {{ bubbles: true }}));
        el.dispatchEvent(new Event('blur', {{ bubbles: true }}));
        return true;
    }}
    function findInput(placeholders, labelWords) {{
        const inputs = Array.from(document.querySelectorAll('input:not([type="hidden"]):not([type="file"]):not([type="checkbox"]):not([type="radio"]), textarea'));
        for (const kw of placeholders) {{
            const found = inputs.find(i => (i.placeholder || '').includes(kw) && !i.disabled);
            if (found) return found;
        }}
        if (labelWords) {{
            for (const lw of labelWords) {{
                const labels = Array.from(document.querySelectorAll('label, div, span')).filter(el => el.children.length <= 2 && (el.textContent || '').trim().startsWith(lw));
                for (const lb of labels) {{
                    let p = lb.parentElement;
                    for (let k = 0; k < 4 && p; k++) {{
                        const inp = p.querySelector('input:not([type="hidden"]):not([type="file"]):not([disabled])');
                        if (inp) return inp;
                        p = p.parentElement;
                    }}
                }}
            }}
        }}
        return null;
    }}
    function realClick(el) {{
        if (!el) return false;
        el.scrollIntoView({{ block: 'center', behavior: 'instant' }});
        ['mousedown', 'mouseup', 'click'].forEach(evt => {{
            el.dispatchEvent(new MouseEvent(evt, {{ view: window, bubbles: true, cancelable: true }}));
        }});
        return true;
    }}
    if (D.soft_name !== null) {{
        setReactVal(findInput(['请输入软件名称', '软件名称', '商标名称'], ['软件名称', '商标名称']), D.soft_name);
    }}
    if (D.company !== null) {{
        setReactVal(findInput(['请输入著作权人', '著作权人', '注册人'], ['著作权人', '注册人']), D.company);
    }}
    if (D.reg_no !== null) {{
        setReactVal(findInput(['请输入登记号', '登记号', '注册号'], ['登记号', '注册号']), D.reg_no);
    }}
    if (D.tiktok_name !== null) {{
        const tabBtn = Array.from(document.querySelectorAll('span, div, button, label')).find(el => el.children.length === 0 && (el.textContent || '').trim() === '基于商标/软著名称命名');
        if (tabBtn) realClick(tabBtn);
        setReactVal(findInput(['基于商标/软著名称命名', '请输入名称'], ['抖音账号名称']), D.tiktok_name);
    }}
    if (D.op_name !== null && D.op_name !== '') {{
        setReactVal(findInput(['实际运营此抖音号人员姓名', '人员姓名', '请输入姓名'], ['姓名']), D.op_name);
    }}
    if (D.op_idcard !== null && D.op_idcard !== '') {{
        setReactVal(findInput(['真实的身份账号信息', '身份账号', '身份证'], ['身份证号']), D.op_idcard);
    }}
    if (D.op_phone !== null && D.op_phone !== '') {{
        setReactVal(findInput(['请输入手机号', '手机号'], ['手机号']), D.op_phone);
    }}
    if (D.op_code !== null && D.op_code !== undefined && D.op_code !== '') {{
        setReactVal(findInput(['请输入验证码', '验证码'], ['验证码']), D.op_code);
    }}
    if (D.submit_after_code) {{
        setTimeout(() => {{
            const submitBtn = Array.from(document.querySelectorAll('button, span, div, a')).find(el => el.children.length === 0 && (el.textContent || '').trim() === '提交');
            if (submitBtn) realClick(submitBtn);
        }}, Number(D.submit_delay_ms) || 3000);
    }}
    if (D.click_code) {{
        setTimeout(() => {{
            const codeBtn = Array.from(document.querySelectorAll('span, button, a, div')).find(el => el.children.length === 0 && (el.textContent || '').trim() === '获取验证码');
            if (codeBtn) realClick(codeBtn);
        }}, 250);
    }}
    if (D.trigger_upload_idx === 1) {{
        const up1 = Array.from(document.querySelectorAll('span, div')).find(el => el.children.length === 0 && (el.textContent || '').trim() === '上传图片');
        if (up1) realClick(up1);
    }} else if (D.trigger_upload_idx === 2) {{
        const up2 = Array.from(document.querySelectorAll('span, div')).find(el => el.children.length === 0 && (el.textContent || '').trim() === '点击上传');
        if (up2) realClick(up2);
    }}
    """
    return " ".join(line.strip() for line in js.splitlines() if line.strip())


