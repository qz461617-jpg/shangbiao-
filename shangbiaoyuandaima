def increment_code(text, total_offset):
    if total_offset == 0:
        return text
    match = re.search(r'(\d+)(?!.*\d)', text)
    if not match:
        return text
    num_str = match.group(1)
    new_num = str(int(num_str) + total_offset).zfill(len(num_str))
    start, end = match.span(1)
    return text[:start] + new_num + text[end:]


def sync_tmzc_with_reg(tmzc_template, old_reg_base, new_reg_val, total_offset, step_tmzc):
    m = re.search(r'(MZC)(\d+?)([A-Z]\d+|\*|$)', tmzc_template, re.IGNORECASE)
    if m and new_reg_val:
        s, e = m.span(2)
        return tmzc_template[:s] + new_reg_val + tmzc_template[e:]
    if old_reg_base and old_reg_base in tmzc_template:
        return tmzc_template.replace(old_reg_base, new_reg_val, 1)
    return increment_code(tmzc_template, total_offset * step_tmzc)


def calc_ten_year_expiry(reg_date_str):
    m = re.search(r'(\d{4})\D+(\d{1,2})\D+(\d{1,2})', reg_date_str.strip())
    if not m:
        return "2030年04月06日"
    y, mo, d = int(m.group(1)), int(m.group(2)), int(m.group(3))
    try:
        dt_start = datetime(y + 10, mo, d)
        dt_exp = dt_start - timedelta(days=1)
        return f"{dt_exp.year:04d}年{dt_exp.month:02d}月{dt_exp.day:02d}日"
    except ValueError:
        return f"{y + 10:04d}年{mo:02d}月{max(1, d - 1):02d}日"


def calc_one_year_auth_expiry(start_date_str):
    m = re.search(r'(\d{4})\D+(\d{1,2})\D+(\d{1,2})', start_date_str.strip())
    if not m:
        return "2027年10月26日"
    y, mo, d = int(m.group(1)), int(m.group(2)), int(m.group(3))
    return f"{y + 1:04d}年{mo:02d}月{d:02d}日"


def increment_soft_name(text, total_offset):
    text_s = text.strip()
    if not text_s or total_offset == 0:
        return text_s

    ver_match = re.search(r'([vV]\d+(?:\.\d+)*)$', text_s)
    if ver_match:
        ver_str = ver_match.group(1)
        prefix_part = text_s[:ver_match.start(1)]
        num_match = re.search(r'(\d+)(?!.*\d)', prefix_part)
        if num_match:
            num_str = num_match.group(1)
            new_num = str(int(num_str) + total_offset).zfill(len(num_str))
            s, e = num_match.span(1)
            return prefix_part[:s] + new_num + prefix_part[e:] + ver_str
        else:
            return f"{prefix_part}{total_offset + 1}{ver_str}"
    else:
        num_match = re.search(r'(\d+)(?!.*\d)', text_s)
        if num_match:
            num_str = num_match.group(1)
            new_num = str(int(num_str) + total_offset).zfill(len(num_str))
            s, e = num_match.span(1)
            return text_s[:s] + new_num + text_s[e:]
        else:
            return f"{text_s}{total_offset + 1}"


def format_tiktok_account_name(soft_name, add_ver=False, strip_ver=False):
    name = soft_name.strip()
    if strip_ver:
        return re.sub(r'[vV]\d+(\.\d+)*$', '', name).strip()
    if add_ver:
        if not re.search(r'[vV]\d+(\.\d+)*$', name):
            return name + "V1.0"
    return name


def sample_bg_color(img, x, y, default_color=(255, 255, 255)):
    w, h = img.size
    pts = [
        (max(10, min(w - 10, x - 4)), max(10, min(h - 10, y - 4))),
        (max(10, min(w - 10, x + 4)), max(10, min(h - 10, y - 4))),
        (max(10, min(w - 10, x)), max(10, min(h - 10, y - 6)))
    ]
    r_list, g_list, b_list = [], [], []
    for px, py in pts:
        try:
            c = img.getpixel((int(px), int(py)))
            if isinstance(c, tuple) and len(c) >= 3:
                if c[0] > 195 and c[1] > 195 and c[2] > 195:
                    r_list.append(c[0])
                    g_list.append(c[1])
                    b_list.append(c[2])
        except Exception:
            pass
    if r_list:
        return (int(sum(r_list) / len(r_list)), int(sum(g_list) / len(g_list)), int(sum(b_list) / len(b_list)))
    return default_color


